    parameter_error(task_id) = current.ParameterRelativeError;
    adaptive_threshold(task_id) = current.AdaptiveScoreThreshold;
    global_noise_scale(task_id) = current.GlobalNoiseScale;
    maximum_patch_score(task_id) = current.MaximumPatchScore;
    detected_indices_text{task_id} = ...
        indices_to_text(current.DetectedIndices);
    last_error_text{task_id} = current.LastError;
end

task_outlier_counts = reshape( ...
    count_values(task_count_ids), [], 1);
task_multipliers = reshape( ...
    mult_values(task_multiplier_ids), [], 1);

result_table = table( ...
    (1:total_task_count).', ...
    task_experiment_ids, ...
    task_outlier_counts, ...
    task_multipliers, ...
    identification_succeeded, detection_evaluated, ...
    iteration_converged, preclean_fallback_used, ...
    outer_iterations, identification_fit_percent, ...
    detected_count, ...
    tp, fp, fn, tn, ...
    precision_value, recall_value, f1_value, ...
    exact_match, ...
    rmse_before, rmse_after, rmse_reduction_percent, ...
    parameter_error, ...
    adaptive_threshold, global_noise_scale, maximum_patch_score, ...
    detected_indices_text, last_error_text, ...
    'VariableNames', { ...
    'TaskID', 'ExperimentID', 'OutlierCount', ...
    'AmplitudeMultiplier', ...
    'IdentificationSucceeded', 'DetectionEvaluated', ...
    'IterationConverged', 'PrecleanFallbackUsed', ...
    'OuterIterations', 'IdentificationFitPercent', ...
    'DetectedCount', ...
    'TP', 'FP', 'FN', 'TN', ...
    'Precision', 'Recall', 'F1', 'ExactMatch', ...
    'RMSEBefore', 'RMSEAfter', 'RMSEReductionPercent', ...
    'ParameterRelativeError', ...
    'AdaptiveScoreThreshold', 'GlobalNoiseScale', ...
    'MaximumPatchScore', ...
    'DetectedIndices', 'LastError'});

condition_summary = summarize_detection_results( ...
    result_table, count_values, mult_values, 'patch');

end


function result = run_one_patch_task( ...
    task_id, experiment_ids, count_ids, multiplier_ids, data, cfg)

warning('off', 'all');

experiment_id = experiment_ids(task_id);
count_id = count_ids(task_id);
multiplier_id = multiplier_ids(task_id);

current_count = data.outlier_count_values(count_id);

y = data.y_all(:, experiment_id, count_id, multiplier_id);
y_clean = data.y_clean_all(:, experiment_id);
u = data.u_all(:, experiment_id);

true_indices = data.outlier_indices_all( ...
    1:current_count, experiment_id, count_id);

result = run_identification_patch_pipeline( ...
    y, y_clean, u, data.Ts, true_indices, data, cfg);

end


function result = run_identification_patch_pipeline( ...
    y, y_clean, u, Ts, true_outlier_indices, data, cfg)

y = y(:);
y_clean = y_clean(:);
u = u(:);
N = numel(y);

working_output = y;
repaired_output = y;
previous_repaired_output = y;
previous_detected_mask = false(N, 1);

detected_indices = zeros(0, 1);
detected_mask = false(N, 1);
patch_score = nan(N, 1);

identification_succeeded = false;
detection_evaluated = false;
iteration_converged = false;
preclean_fallback_used = false;
completed_iteration_count = 0;

identification_fit_percent = NaN;
adaptive_score_threshold = NaN;
global_noise_scale = NaN;
parameter_error = NaN;
last_error = '';

final_system = [];

for outer_iteration = 1:cfg.PatchMaximumOuterIterations
    completed_iteration_count = outer_iteration;

    try
        [identified_system, model_prediction, current_fit] = ...
            identify_robust_ct_model( ...
            working_output, u, Ts, ...
            cfg.NumberOfPoles, cfg.NumberOfZeros, ...
            cfg.KnownTransportDelay, ...
            cfg.PatchTFESTRobustErrorThreshold, ...
            cfg.PatchTFESTMaxIterations);

    catch first_identification_error
        % Only the first failed identification may trigger Patch precleaning.
        if outer_iteration ~= 1 || preclean_fallback_used
            last_error = sprintf('%s: %s', ...
                class(first_identification_error), ...
                first_identification_error.message);
            break;
        end

        try
            [preclean_indices, ~, preclean_trend, ~, ~, ~, ~, ~, ~, ~] = ...
                multiscale_patch_detector(y, cfg);

            working_output = y;
            working_output(preclean_indices) = ...
                preclean_trend(preclean_indices);
            preclean_fallback_used = true;

            [identified_system, model_prediction, current_fit] = ...
                identify_robust_ct_model( ...
                working_output, u, Ts, ...
                cfg.NumberOfPoles, cfg.NumberOfZeros, ...
                cfg.KnownTransportDelay, ...
                cfg.PatchTFESTRobustErrorThreshold, ...
                cfg.PatchTFESTMaxIterations);

        catch retry_error
            last_error = sprintf( ...
                ['First identification failed: %s: %s | ' ...
                 'Patch-preclean retry failed: %s: %s'], ...
                class(first_identification_error), ...
                first_identification_error.message, ...
                class(retry_error), retry_error.message);
            break;
        end
    end

    identification_succeeded = true;
    identification_fit_percent = current_fit;
    final_system = identified_system;

    try
        % Detection always evaluates the original measured output.
        residual = y - model_prediction;

        [detected_indices, patch_score, expected_residual, ...
            ~, adaptive_score_threshold, ~, ...
            global_noise_scale, ~, ~, ~] = ...
            multiscale_patch_detector(residual, cfg);

        detected_mask = false(N, 1);
        detected_mask(detected_indices) = true;

        expected_output = model_prediction + expected_residual;

        repaired_output = y;
        repaired_output(detected_mask) = ...
            expected_output(detected_mask);

        detection_evaluated = true;

    catch patch_error
        last_error = sprintf('Patch detection failed: %s: %s', ...
            class(patch_error), patch_error.message);
        break;
    end

    repair_change = norm( ...
        repaired_output - previous_repaired_output, 2) / ...
        max(norm(previous_repaired_output, 2), eps);

    same_detected_set = outer_iteration > 1 && ...
        isequal(detected_mask, previous_detected_mask);

    if same_detected_set && ...
            repair_change <= cfg.PatchRepairRelativeTolerance
        iteration_converged = true;
        break;
    end

    previous_detected_mask = detected_mask;
