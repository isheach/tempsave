comparison.Down_ExactMatch = ...
    down_summary.ExactMatchRate;
comparison.Down_MeanTP = down_summary.MeanTP;
comparison.Down_MeanFP = down_summary.MeanFP;
comparison.Down_MeanFN = down_summary.MeanFN;
comparison.Down_Precision = down_summary.Precision;
comparison.Down_Recall = down_summary.Recall;
comparison.Down_F1 = down_summary.F1;
comparison.Down_MeanParameterError = ...
    down_summary.MeanParameterRelativeError;

comparison.Patch_IDSuccess = ...
    patch_summary.IdentificationSuccessRate;
comparison.Patch_DetectionRate = ...
    patch_summary.DetectionEvaluatedRate;
comparison.Patch_ConvergenceRate = ...
    patch_summary.IterationConvergenceRate;
comparison.Patch_ExactMatch = ...
    patch_summary.ExactMatchRate;
comparison.Patch_MeanTP = patch_summary.MeanTP;
comparison.Patch_MeanFP = patch_summary.MeanFP;
comparison.Patch_MeanFN = patch_summary.MeanFN;
comparison.Patch_Precision = patch_summary.Precision;
comparison.Patch_Recall = patch_summary.Recall;
comparison.Patch_F1 = patch_summary.F1;
comparison.Patch_MeanParameterError = ...
    patch_summary.MeanParameterRelativeError;
comparison.Patch_MeanRMSEBefore = ...
    patch_summary.MeanRMSEBefore;
comparison.Patch_MeanRMSEAfter = ...
    patch_summary.MeanRMSEAfter;
comparison.Patch_RMSEReductionPercent = ...
    patch_summary.MeanRMSEReductionPercent;

comparison.F1Difference_PatchMinusDown = ...
    comparison.Patch_F1 - comparison.Down_F1;

end


function settings_table = config_to_table( ...
    cfg, parallel_mode_used, worker_count, ...
    down_elapsed_seconds, patch_elapsed_seconds)

items = { ...
    'NumberOfSamples'; ...
    'NumberOfExperiments'; ...
    'OutlierCounts'; ...
    'AmplitudeMultipliers'; ...
    'SampleTime'; ...
    'TrueNumerator'; ...
    'TrueDenominator'; ...
    'NumberOfPoles'; ...
    'NumberOfZeros'; ...
    'KnownTransportDelay'; ...
    'DownSplitCount'; ...
    'DownIdentificationRSSThreshold'; ...
    'DownMinimumSequenceLength'; ...
    'DownGamma'; ...
    'DownChildPredictionIC'; ...
    'DownFullRecordPredictionIC'; ...
    'PatchPredictionIC'; ...
    'PatchMaximumOuterIterations'; ...
    'PatchRepairRelativeTolerance'; ...
    'PatchTFESTRobustErrorThreshold'; ...
    'PatchLengths'; ...
    'PatchOverlapRatio'; ...
    'PatchPolynomialOrder'; ...
    'PatchIRLSIterations'; ...
    'PatchBisquareTuningConstant'; ...
    'PatchTargetSequenceFalseAlarmRate'; ...
    'PatchMinimumMultiscaleSupport'; ...
    'PatchScalePoolingStrength'; ...
    'ParallelRequested'; ...
    'ParallelUsed'; ...
    'ParallelWorkers'; ...
    'DownElapsedSeconds'; ...
    'PatchElapsedSeconds'};

values = { ...
    cfg.NumberOfSamples; ...
    cfg.NumberOfExperiments; ...
    mat2str(cfg.OutlierCounts); ...
    mat2str(cfg.AmplitudeMultipliers); ...
    cfg.SampleTime; ...
    mat2str(cfg.TrueNumerator); ...
    mat2str(cfg.TrueDenominator); ...
    cfg.NumberOfPoles; ...
    cfg.NumberOfZeros; ...
    cfg.KnownTransportDelay; ...
    cfg.DownSplitCount; ...
    cfg.DownIdentificationRSSThreshold; ...
    cfg.DownMinimumSequenceLength; ...
    cfg.DownGamma; ...
    'estimated'; ...
    'zero'; ...
    'zero'; ...
    cfg.PatchMaximumOuterIterations; ...
    cfg.PatchRepairRelativeTolerance; ...
    cfg.PatchTFESTRobustErrorThreshold; ...
    mat2str(cfg.PatchLengths); ...
    cfg.PatchOverlapRatio; ...
    cfg.PatchPolynomialOrder; ...
    cfg.PatchIRLSIterations; ...
    cfg.PatchBisquareTuningConstant; ...
    cfg.PatchTargetSequenceFalseAlarmRate; ...
    cfg.PatchMinimumMultiscaleSupport; ...
    cfg.PatchScalePoolingStrength; ...
    cfg.UseParallel; ...
    parallel_mode_used; ...
    worker_count; ...
    down_elapsed_seconds; ...
    patch_elapsed_seconds};

settings_table = table(items, values, ...
    'VariableNames', {'Item', 'Value'});

end


%% ========================================================================
%  Statistics / utility helpers
% ========================================================================

function value = corrected_mad(x)

x = x(:);
x = x(isfinite(x));

if isempty(x)
    value = NaN;
    return;
end

center = median(x);
raw_mad = median(abs(x - center));

value = 1.482602218505602 * raw_mad;

end


function [TP, FP, FN, TN] = ...
    confusion_counts(true_indices, detected_indices, N)

true_indices = unique(true_indices(:));
detected_indices = unique(detected_indices(:));

true_indices = true_indices( ...
    true_indices >= 1 & true_indices <= N);

detected_indices = detected_indices( ...
    detected_indices >= 1 & detected_indices <= N);

true_mask = false(N, 1);
detected_mask = false(N, 1);

true_mask(true_indices) = true;
detected_mask(detected_indices) = true;

TP = sum(true_mask & detected_mask);
FP = sum(~true_mask & detected_mask);
FN = sum(true_mask & ~detected_mask);
TN = sum(~true_mask & ~detected_mask);

end


function value = safe_divide(numerator, denominator)

if denominator <= 0
    value = 0;
else
    value = numerator / denominator;
end

end


function text = indices_to_text(indices)

indices = unique(indices(:));

if isempty(indices)
    text = '[]';
else
    text = mat2str(indices.');
end

end
